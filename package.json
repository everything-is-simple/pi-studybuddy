{
  "name": "pi-studybuddy",
  "version": "0.1.0",
  "private": true,
  "description": "pi-studybuddy - 考试驱动学习闭环桌面应用（Electron 壳 + pi 扩展层 + StudyBuddy 业务内核）",
  "main": "dist/main/main.js",
  "author": "pi-studybuddy",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc -p tsconfig.node.json && vite build",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "smoke": "node scripts/smoke.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "dependencies": {
    "@earendil-works/pi-ai": "0.80.10",
    "@earendil-works/pi-coding-agent": "0.80.10",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "typebox": "1.1.38"
  }
}